GCP_PROJECT_ID=your-gcp-project-id
AZURE_SUBSCRIPTION_ID=your-subscription-id

# Application
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO
SECRET_KEY=your-secret-key-change-this

# Admin Tools
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin
